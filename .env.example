# Copy this file to .env and replace every value before starting Docker.
POSTGRES_DB=servixp
POSTGRES_USER=servixp_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

JWT_SECRET=replace-with-at-least-64-random-characters
FILE_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-with-node-crypto
API_BIND=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082,http://127.0.0.1:8082
EXPO_PUBLIC_API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=false
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
